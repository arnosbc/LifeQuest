<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/questly_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy"
        android:textColor="#DC2626"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Abre Questly para ver tus tareas."
        android:textColor="#71717A"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/row0"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/row0_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textColor="#71717A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/row0_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#18181B"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/row0_done"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#18181B"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/row1_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textColor="#71717A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/row1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#18181B"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/row1_done"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#18181B"
                android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/row2_time"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textColor="#71717A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/row2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#18181B"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/row2_done"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#18181B"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
