<?xml version="1.0" encoding="utf-8"?>
<!-- H-06: solo HTTPS y solo certificados del sistema (sin CAs del usuario). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
